rules_version = '2';
// MyUniMentor accounts. Paste into Firebase console → Databases & Storage → Firestore → Rules, then Publish.
// The email-code login adds two claims to every user: em (their verified email) and admin (true for MyUniMentor staff).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function myEmail() { return request.auth.token.em; }
    function isParentOf(uid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.parents; }
    function short(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function fewer(d, k, n) { return !(k in d) || (d[k] is list && d[k].size() <= n); }
    // Keeps every profile small, so nobody can stuff the database.
    function sane(d) {
      return d.size() <= 25 && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && short(d, 'city', 60) && short(d, 'school', 120) && short(d, 'cls', 30) && short(d, 'stream', 10)
        && fewer(d, 'saved', 60) && fewer(d, 'exams', 40) && fewer(d, 'targets', 20) && fewer(d, 'parents', 5) && fewer(d, 'parentEmails', 5)
        && (!('check' in d) || (d.check is map && d.check.size() <= 8));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || request.auth.uid in resource.data.parents);
      // A profile is created together with its WhatsApp number (one number = one account).
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.email == myEmail()
                    && request.resource.data.role in ['student', 'parent'] && sane(request.resource.data)
                    && request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('^[6-9][0-9]{9}$')
                    && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.whatsapp)).data.uid == uid
                    // who invited them (for the free psychometric test): only set when the account is created
                    && (!('ref' in request.resource.data) || (request.resource.data.ref is string && request.resource.data.ref.matches('^u[0-9a-f]{27}$') && request.resource.data.ref != uid));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && sane(request.resource.data)
                    && request.resource.data.email == resource.data.email && request.resource.data.role == resource.data.role
                    && request.resource.data.get('whatsapp', '') == resource.data.get('whatsapp', '')
                    && request.resource.data.get('ref', '') == resource.data.get('ref', ''));
      allow delete: if isAdmin();   // students and parents delete with an emailed code; the server keeps a copy in archive
      allow create: if isAdmin();   // staff restoring an account from the Bin
    }
    match /links/{id} {
      allow read: if signedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childEmail == myEmail() || isAdmin());
      allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid
                    && request.resource.data.parentEmail == myEmail() && request.resource.data.status == 'pending'
                    && request.resource.data.size() <= 8 && short(request.resource.data, 'parentName', 80) && short(request.resource.data, 'childEmail', 254);
      allow update: if signedIn() && resource.data.childEmail == myEmail() && request.resource.data.childUid == request.auth.uid
                    && request.resource.data.parentUid == resource.data.parentUid && request.resource.data.parentEmail == resource.data.parentEmail
                    && request.resource.data.childEmail == resource.data.childEmail
                    && request.resource.data.status in ['accepted', 'declined'] && short(request.resource.data, 'childName', 80);
      allow delete: if signedIn() && (resource.data.parentUid == request.auth.uid || isAdmin());
    }
    match /requests/{id} {
      allow read: if signedIn() && (request.auth.uid in resource.data.viewers || isAdmin());
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.status == 'requested'
                    && request.auth.uid in request.resource.data.viewers && request.resource.data.viewers.size() <= 7
                    && request.resource.data.size() <= 16 && short(request.resource.data, 'topic', 600)
                    && (request.resource.data.uid == request.auth.uid || isParentOf(request.resource.data.uid));
      allow update, delete: if isAdmin();
    }
    // One account per WhatsApp number. Claimed in the same write as the profile; nobody can read or take someone else's.
    match /phones/{n} {
      allow create: if signedIn() && n.matches('^[6-9][0-9]{9}$') && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.whatsapp == n;
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
      allow create: if isAdmin();   // staff restoring an account or changing its number
    }
    // Psychometric test. access/{uid} is written only by the server (payment, three invites, a code) or by staff.
    match /access/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isParentOf(uid));
      allow write: if isAdmin();
    }
    // Answers save as the student goes; once the report is done it cannot be changed (staff can reset it).
    match /results/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isParentOf(uid));
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
                    && exists(/databases/$(database)/documents/access/$(uid))
                    && (resource == null || !('done' in resource.data))
                    && request.resource.data.keys().hasOnly(['uid', 'state', 'updated', 'done', 'name', 'cls', 'stream', 'code', 'top', 'topN'])
                    && request.resource.data.state is map && request.resource.data.state.size() <= 20;
      allow delete: if isAdmin();
      allow create: if isAdmin();   // staff restoring a report from the Bin
    }
    match /codes/{id} { allow read, write: if isAdmin(); }
    match /payments/{id} { allow read: if isAdmin(); }
    match /announcements/{id} { allow read, write: if isAdmin(); }
    match /archive/{id} { allow read, create, delete: if isAdmin(); }   // the Bin: restore or delete forever
    match /crm/{id} { allow read, write: if isAdmin(); }        // staff-only follow-ups: stage, next date, notes
    match /stats/{id} { allow read: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
